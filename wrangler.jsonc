{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pscv-room",
  "account_id": "e8cee5957315e28c1b4e4b2410c5fbcc",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.relnets.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_NAME": "PSCV Room 2.0",
    "AUTH_MODE": "cloudflare-access",
    "AUTH_IDENTITY_PROVIDER": "azureAD",
    "ACCESS_TEAM_DOMAIN": "withered-glade-36de.cloudflareaccess.com",
    "ACCESS_AUD": "a6ff2dac1a39458d77300046ff009cf76fa82a3121190677c4291ca49e73fae2",
    "VAPID_SUBJECT": "mailto:ricardo_mtzh@outlook.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pscv-room",
      "database_id": "14ed5055-3366-4883-a6df-0349874337f0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MATERIALS_BUCKET", "bucket_name": "psicologia" }
  ]
}
