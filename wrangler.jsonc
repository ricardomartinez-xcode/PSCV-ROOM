{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pscv-room",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.rlead.xyz", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_NAME": "PSCV Room 2.0",
    "AUTH_MODE": "cloudflare-access",
    "AUTH_IDENTITY_PROVIDER": "azureAD",
    "ACCESS_TEAM_DOMAIN": "relead.cloudflareaccess.com",
    "ACCESS_AUD": "73917fb49392c9e1560043d25052f153e248a38288f890bf2cc69cf5db3c5e41",
    "VAPID_PUBLIC_KEY": "BALSiB76LABnDM1GruMSu0vSwRrKlButLeRTLNDtoXhxjkXmdxAeCQ_G2rbGJPg3IA73340XNy4w0851fCuw8WE",
    "VAPID_SUBJECT": "mailto:ricardo_mtzh@outlook.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pscv-room",
      "database_id": "49c23a1e-de2c-473b-a627-d6efe862b4b3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MATERIALS_BUCKET", "bucket_name": "psicologia" }
  ]
}
