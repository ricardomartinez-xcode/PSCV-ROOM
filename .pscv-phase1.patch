diff --git a/app/workspace.css b/app/workspace.css
index fcedc9a..1da9aea 100644
--- a/app/workspace.css
+++ b/app/workspace.css
@@ -1630,3 +1630,32 @@ a svg {
 .memberActionsCell button { width: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
 @media (max-width: 980px) { .groupMemberForm { grid-template-columns: 1fr 1fr; } .groupMemberActions, .groupMemberMessage { grid-column: 1 / -1; } }
 @media (max-width: 620px) { .groupMemberForm { grid-template-columns: 1fr; margin-inline: 8px; } .groupMemberActions, .groupMemberMessage { grid-column: auto; } .groupMemberActions { flex-wrap: wrap; } }
+
+/* Horario y profesores */
+.scheduleScreen { display: grid; gap: 18px; }
+.scheduleHero { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 22px; border: 1px solid var(--line, #dbe4ea); border-radius: 22px; background: var(--surface, #fff); }
+.scheduleHero h2, .sectionTitleRow h3 { margin: 3px 0 5px; }
+.scheduleHero p { margin: 0; color: var(--muted, #64748b); }
+.scheduleEyebrow { font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--muted, #64748b); }
+.professorGrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
+.professorCard { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border: 1px solid var(--line, #dbe4ea); border-radius: 18px; background: var(--surface, #fff); }
+.courseIcon { width: 38px; height: 38px; display: inline-grid; place-items: center; flex: 0 0 auto; border-radius: 12px; background: color-mix(in srgb, currentColor 10%, transparent); }
+.professorCard div { min-width: 0; display: grid; gap: 3px; }
+.professorCard small, .professorCard span { color: var(--muted, #64748b); overflow-wrap: anywhere; }
+.weeklySchedule { display: grid; gap: 12px; }
+.sectionTitleRow { display: flex; align-items: center; justify-content: space-between; }
+.scheduleDay { display: grid; grid-template-columns: minmax(84px, .22fr) 1fr; gap: 14px; padding: 14px 16px; border: 1px solid var(--line, #dbe4ea); border-radius: 18px; background: var(--surface, #fff); }
+.scheduleDay h4 { margin: 5px 0; }
+.scheduleDayEntries { display: grid; gap: 8px; }
+.scheduleEntry { display: flex; gap: 10px; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid color-mix(in srgb, var(--line, #dbe4ea) 70%, transparent); }
+.scheduleEntry:last-child { border-bottom: 0; }
+.scheduleEntry div { display: grid; gap: 3px; }
+.scheduleEntry span, .scheduleEntry small { display: flex; align-items: center; gap: 6px; color: var(--muted, #64748b); }
+.scheduleEmpty { display: grid; place-items: center; text-align: center; gap: 6px; padding: 28px; border: 1px dashed var(--line, #cbd5e1); border-radius: 18px; color: var(--muted, #64748b); }
+.scheduleEmpty p { margin: 0; }
+@media (max-width: 640px) { .scheduleHero { padding: 17px; } .scheduleDay { grid-template-columns: 1fr; } }
+
+/* Bottom navigation with Horario */
+.bottomNav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.bottomNav.adminBottomNav { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+@media (max-width: 640px) { .bottomNav button { font-size: 10px; } .bottomNav button svg { width: 19px; height: 19px; } }
